{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "../out/e2e",
    "lib": ["ES2021"],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vscode", "mocha"]
  },
  "include": [
    "extension-host/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ui/**"
  ]
}
